# Settings and credentials for xewe (xewe provision, xewe test, xewe serial, xewe flash).
#
# Copy to .env (git-ignored) in the harness project directory, or in this xewe-os-tools checkout,
# and fill in. Which file is used, first found wins:
#   1. --env FILE (xewe provision --from FILE), else the XEWE_ENV variable
#   2. .env in the project directory (the one with xewe.lock)
#   3. .env in the xewe-os-tools source checkout (the local: source setup recorded)
# Variables already set in the environment win over the file; flags win over both.
# KEY=VALUE lines; # comments; optional "export " prefix; optional '...' or "..." quotes;
# nothing is interpolated. Never commit the real file; agents never read it.

# --- provisioning (first-boot prompts)
XEWE_DEVICE_NAME="Kitchen Lights"
XEWE_WIFI_SSID=example-network
XEWE_WIFI_PASSWORD=change-me
# GMT+HH:MM or GMT-HH:MM; empty = accept the timezone the board detects
XEWE_TIMEZONE=
# all, none, or a comma-separated list (buttons,pins,wifi,time,scheduler,web-interface)
XEWE_PROVISION_MODULES=all

# --- module tests (GPIO numbers on the test board; an empty value counts as unset)
# a free GPIO for the buttons test (empty: that test is skipped)
XEWE_TEST_BUTTONS_PIN=
# an ADC1 pin for the pins test (empty: 1)
XEWE_TEST_PINS_ADC_PIN=1

# --- board selection (empty = auto-select the attached board / its chip)
XEWE_PORT=
XEWE_CHIP=
